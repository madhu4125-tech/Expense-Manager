{
  "name": "expense-manager-android",
  "version": "2.0.0",
  "private": true,
  "description": "My Expenses - Android app (Capacitor)",
  "scripts": {
    "build": "tailwindcss -i src/input.css -o www/tailwind.css --minify && esbuild src/app.js --bundle --minify --outfile=www/app.js && node scripts/copy-assets.js",
    "sync": "npm run build && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "@fortawesome/fontawesome-free": "^6.5.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.2.0",
    "esbuild": "^0.24.0",
    "tailwindcss": "3.4.17"
  }
}
